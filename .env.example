# ==============================================================================
# SmartResolve — Supabase Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and provide your project credentials from:
# Supabase Dashboard -> Project Settings -> API
# ==============================================================================

# Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Publishable API Key (safe for browser client-side usage)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Public Anonymous API Key (legacy fallback for backward compatibility)
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here

# Note: NEVER place any secret admin or backend service key in this frontend configuration!
